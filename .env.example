HOST=0.0.0.0
PORT=1102

# 每个 Worker 都拥有独立事件循环和 Redis/数据库等运行时资源。中小规模实例建议 2+2；
# 留空或删除时按可用 CPU 自动分配，允许范围为 1-64。
SERVICE_WORKERS=2
COLLECTOR_WORKERS=2

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=iot
DB_PASSWORD=iot
DB_DATABASE=iot

# TimescaleDB device_data 存储策略。压缩延迟必须大于可能发生 UPDATE/补写的窗口，
# 防止命令结果等回写命中已压缩 chunk。关闭后只停止后续自动压缩，不自动解压历史 chunk。
DEVICE_DATA_COMPRESSION_POLICY_ENABLED=true
DEVICE_DATA_CHUNK_INTERVAL_HOURS=168
DEVICE_DATA_COMPRESSION_AFTER_HOURS=168
DEVICE_DATA_MUTABLE_WINDOW_HOURS=48

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Transactional Outbox 运维告警阈值；设为 0 可关闭对应告警。
OUTBOX_PENDING_ALERT_THRESHOLD=1000
OUTBOX_OLDEST_AGE_ALERT_MS=300000
OUTBOX_DEAD_LETTER_ALERT_THRESHOLD=1
# 幂等消费凭据保留天数；设为 0 可关闭自动清理。
OUTBOX_RECEIPT_RETENTION_DAYS=30

# 本平台的稳定 UUID。edgenode 的每个 LuCI 平台条目必须填写目标实例对应的 UUID。
# 多个 iot-engine 实例不能复用同一个 UUID。
EDGE_PLATFORM_ID=00000000-0000-7000-8000-000000000001
# 节点连接及固件下载可访问的 HTTP(S) 基础地址，不要包含 /edge/v1 路径。
EDGE_PUBLIC_BASE_URL=https://i.a-z.xin

# VPN Hub（Linux 服务端）兼容回退配置。新部署由 vpn_network 的 iot-server
# 记录自动生成并启用，不需要填写这些变量；旧部署仍可用它们迁移到表配置。
# Windows 客户端私钥由客户端本地生成，Edge 节点私钥由节点本地生成。
# 同机运行多个实例时，只允许实际承载 VPN 的实例启用后台同步。
# API、媒体和 VPN 在同一个进程运行；此开关只控制 VPN 后台同步。
VPN_HUB_ENABLED=true
VPN_HUB_INTERFACE=wg-iot
VPN_HUB_PRIVATE_KEY=
VPN_HUB_PUBLIC_KEY=
VPN_HUB_ENDPOINT=
VPN_HUB_LISTEN_PORT=51820

# 异步报文日志默认写入可执行文件同级 logs/；可设置为服务可写目录。
# PACKET_LOG_DIRECTORY=/var/lib/iot-engine/logs
# 可设为 TRACE / DEBUG / INFO / WARN / ERROR / OFF。
PACKET_LOG_LEVEL=DEBUG

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# 启用后，ZLMediaKit C SDK 在同一个服务进程内启动。
# 媒体数据面使用 ZLM 自己的 worker，与 Ruvia 业务 worker、SIP loop 隔离。
GB28181_ENABLED=false
GB28181_SIP_DOMAIN=
GB28181_SIP_ID=
GB28181_SIP_HOST=0.0.0.0
GB28181_SIP_PUBLIC_IP=
GB28181_SIP_PORT=5060
GB28181_SIP_PASSWORD=
GB28181_SIP_TRANSPORT=udp
GB28181_REGISTRATION_TIMEOUT_SECONDS=180
GB28181_INVITE_TIMEOUT_SECONDS=15
# 每个观看会话的租约时长；前端失联超时后只释放对应 viewer，全部释放后才关流。
GB28181_VIEWER_LEASE_TIMEOUT_SECONDS=90
GB28181_NONCE_TTL_SECONDS=300
GB28181_SIP_LOGGING=true
GB28181_MEDIA_TOKEN_SECRET=
GB28181_MEDIA_TOKEN_TTL_SECONDS=300
# 浏览器直连 ZLM 时填写前端的精确 Origin，禁止使用 *。
GB28181_MEDIA_CORS_ORIGIN=
GB28181_RECORDING_ENABLED=false
GB28181_RECORD_ROOT=
GB28181_RECORD_MAX_SEGMENT_SECONDS=3600
# ZLM 会分别创建同等数量的 EventPoller 和 WorkThread；默认各 1 个，
# 避免绕过 iot-engine 的总 CPU 预算。按压测结果显式调大。
ZLM_WORKER_THREADS=1
# ZLM 日志级别：0 Trace、1 Debug、2 Info、3 Warn、4 Error。
ZLM_LOG_LEVEL=2
ZLM_HTTP_PORT=8080
ZLM_HTTPS_PORT=8443
ZLM_RTSP_PORT=8554
ZLM_RTSPS_PORT=8322
ZLM_RTMP_PORT=1935
ZLM_RTMPS_PORT=1936
ZLM_RTC_PORT=8000
ZLM_SRT_PORT=9000
ZLM_TLS_ENABLED=false
ZLM_TLS_PEM_PATH=
ZLM_TLS_PASSWORD=
# 留空时根据 GB28181_RTP_PUBLIC_IP 和 ZLM_HTTP_PORT 生成播放地址。
ZLM_PUBLIC_BASE_URL=
GB28181_RTP_PUBLIC_IP=
GB28181_RTP_PORT_START=30000
GB28181_RTP_PORT_END=30500
