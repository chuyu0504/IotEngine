set(IOT_ENGINE_MUSL_ROOT "$ENV{IOT_ENGINE_MUSL_ROOT}" CACHE PATH "Prebuilt LLVM musl toolchain")
if(NOT IOT_ENGINE_MUSL_ROOT)
    find_program(IOT_ENGINE_MISE_EXECUTABLE mise REQUIRED)
    execute_process(COMMAND "${IOT_ENGINE_MISE_EXECUTABLE}" where github:cross-tools/clang-cross
        OUTPUT_VARIABLE IOT_ENGINE_MUSL_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    string(APPEND IOT_ENGINE_MUSL_ROOT "/x86_64-unknown-linux-musl")
endif()
if(NOT EXISTS "${IOT_ENGINE_MUSL_ROOT}/bin/clang++")
    message(FATAL_ERROR "Install clang-cross globally with mise, or set IOT_ENGINE_MUSL_ROOT")
endif()
set(CMAKE_C_COMPILER "${IOT_ENGINE_MUSL_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${IOT_ENGINE_MUSL_ROOT}/bin/clang++")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_SYSROOT "${IOT_ENGINE_MUSL_ROOT}/x86_64-unknown-linux-musl/sysroot")
set(CMAKE_AR "${IOT_ENGINE_MUSL_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${IOT_ENGINE_MUSL_ROOT}/bin/llvm-ranlib")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
