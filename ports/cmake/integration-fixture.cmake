# Disposable iot-engine fixture for the Bun integration tests (cmake -P).
#
#   -DFIXTURE_CONFIG=<file>  generated by iot_engine_add_integration_fixture()
#   -DACTION=start|stop|run
#   -DSCRIPT=<tests/*.ts>    run only
#   -DMIGRATION_FAILURE=<re> run only: drive the migration phase protocol
#
# IOT_TEST_POSTGRES_URL names a PostgreSQL/TimescaleDB server and
# IOT_TEST_REDIS_URL a Redis server. Each fixture recreates its own database
# and Redis database index there. Without both variables every action exits
# with 77, which CTest reports as skipped.
cmake_minimum_required(VERSION 3.29)

include("${FIXTURE_CONFIG}")

set(fixture_skip_code 77)
set(fixture_platform_id 00000000-0000-7000-8000-000000000001)
set(fixture_state "${FIXTURE_DIRECTORY}/state.cmake")

function(fixture_skip reason)
    message(STATUS "SKIP ${FIXTURE}: ${reason}")
    cmake_language(EXIT ${fixture_skip_code})
endfunction()

# --- Shared service endpoints -----------------------------------------------

set(server_url "$ENV{IOT_TEST_POSTGRES_URL}")
set(redis_url "$ENV{IOT_TEST_REDIS_URL}")
if(server_url STREQUAL "" OR redis_url STREQUAL "")
    fixture_skip("IOT_TEST_POSTGRES_URL and IOT_TEST_REDIS_URL are not set (docs/build.md)")
endif()
if(NOT server_url MATCHES "^postgres(ql)?://([^:@/]+)(:([^@/]*))?@([^:/]+)(:([0-9]+))?(/[^?]*)?$")
    message(FATAL_ERROR "IOT_TEST_POSTGRES_URL must be postgres://user[:password]@host[:port][/database]")
endif()
set(db_user "${CMAKE_MATCH_2}")
set(db_password "${CMAKE_MATCH_4}")
set(db_host "${CMAKE_MATCH_5}")
set(db_port "${CMAKE_MATCH_7}")
if(db_port STREQUAL "")
    set(db_port 5432)
endif()
if(NOT redis_url MATCHES "^redis://((([^:@/]*):)?([^@/]*)@)?([^:/@]+)(:([0-9]+))?/?$")
    message(FATAL_ERROR "IOT_TEST_REDIS_URL must be redis://[[user]:password@]host[:port] without a database index")
endif()
set(redis_password "${CMAKE_MATCH_4}")
set(redis_host "${CMAKE_MATCH_5}")
set(redis_port "${CMAKE_MATCH_7}")
if(redis_port STREQUAL "")
    set(redis_port 6379)
endif()

string(REPLACE "-" "_" db_name "iot_architecture_${FIXTURE}")
set(db_credentials "${db_user}")
if(NOT db_password STREQUAL "")
    string(APPEND db_credentials ":${db_password}")
endif()
set(fixture_database_url "postgres://${db_credentials}@${db_host}:${db_port}/${db_name}")
set(redis_credentials "")
if(NOT redis_password STREQUAL "")
    set(redis_credentials ":${redis_password}@")
endif()
set(fixture_redis_url "redis://${redis_credentials}${redis_host}:${redis_port}/${REDIS_DATABASE}")

# --- Helpers ----------------------------------------------------------------

function(fixture_bun)
    execute_process(
        COMMAND "${BUN}" ${ARGN}
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        list(JOIN ARGN " " command)
        message(FATAL_ERROR "bun ${command} failed (${result}); fixture logs: ${FIXTURE_DIRECTORY}")
    endif()
endfunction()

function(fixture_services action)
    fixture_bun("${SOURCE_DIR}/tests/integration-fixture.ts"
        "${action}" "${server_url}" "${db_name}" "${fixture_redis_url}")
endfunction()

function(fixture_instance_directory index out)
    set(${out} "${FIXTURE_DIRECTORY}/instance-${index}" PARENT_SCOPE)
endfunction()

# Writes the complete process configuration; iot-engine reads settings only from
# the .env beside its executable.
function(fixture_write_configuration index)
    fixture_instance_directory(${index} directory)
    math(EXPR port "${API_PORT} + ${index}")
    set(values
        "JWT_SECRET=architecture-test-only-access-secret-000000000"
        "JWT_REFRESH_SECRET=architecture-test-only-refresh-secret-00000000"
        "DB_HOST=${db_host}"
        "DB_PORT=${db_port}"
        "DB_USERNAME=${db_user}"
        "DB_DATABASE=${db_name}"
        "REDIS_HOST=${redis_host}"
        "REDIS_PORT=${redis_port}"
        "REDIS_DATABASE=${REDIS_DATABASE}"
        "HOST=127.0.0.1"
        "PORT=${port}"
        "SERVICE_WORKERS=2"
        "COLLECTOR_WORKERS=1"
        "GB28181_ENABLED=false"
        "VPN_HUB_ENABLED=false"
        "EDGE_PUBLIC_BASE_URL=http://127.0.0.1:${port}"
        "EDGE_PLATFORM_ID=${fixture_platform_id}"
        "PACKET_LOG_DIRECTORY=${directory}/logs")
    if(NOT db_password STREQUAL "")
        list(APPEND values "DB_PASSWORD=${db_password}")
    endif()
    if(NOT redis_password STREQUAL "")
        list(APPEND values "REDIS_PASSWORD=${redis_password}")
    endif()
    if(GB28181)
        list(APPEND values
            "COLLECTOR_WORKERS=2"
            "GB28181_ENABLED=true"
            "GB28181_SIP_DOMAIN=3402000000"
            "GB28181_SIP_ID=34020000002000000001"
            "GB28181_SIP_HOST=127.0.0.1"
            "GB28181_SIP_PUBLIC_IP=127.0.0.1"
            "GB28181_SIP_PORT=${sip_port}"
            "GB28181_SIP_PASSWORD=test"
            "GB28181_SIP_TRANSPORT=both"
            "GB28181_RTP_PUBLIC_IP=127.0.0.1"
            "GB28181_MEDIA_TOKEN_SECRET=gb28181-integration-only-secret"
            "GB28181_RTP_PORT_START=0"
            "GB28181_RTP_PORT_END=0"
            "ZLM_HTTP_PORT=0"
            "ZLM_RTSP_PORT=0"
            "ZLM_RTMP_PORT=0"
            "ZLM_RTC_PORT=0"
            "ZLM_SRT_PORT=0")
    endif()
    list(APPEND values ${SETTINGS})

    # Later entries override earlier ones with the same name.
    set(names "")
    foreach(entry IN LISTS values)
        string(REGEX MATCH "^[A-Z0-9_]+" name "${entry}")
        list(REMOVE_ITEM names "${name}")
        list(APPEND names "${name}")
        set(value_${name} "${entry}")
    endforeach()
    set(content "")
    foreach(name IN LISTS names)
        string(APPEND content "${value_${name}}\n")
    endforeach()
    file(MAKE_DIRECTORY "${directory}/logs")
    file(WRITE "${directory}/.env" "${content}")
endfunction()

function(fixture_alive pid out)
    set(alive FALSE)
    if(CMAKE_HOST_WIN32)
        execute_process(
            COMMAND tasklist /FI "PID eq ${pid}" /FO CSV /NH
            OUTPUT_VARIABLE listing ERROR_QUIET)
        get_filename_component(engine_name "${ENGINE}" NAME)
        string(FIND "${listing}" "\"${engine_name}\"" found)
        if(NOT found EQUAL -1)
            set(alive TRUE)
        endif()
    elseif(EXISTS "/proc/${pid}/exe")
        # Exited (including zombie) or reused process IDs do not resolve to a
        # fixture instance executable.
        file(READ_SYMLINK "/proc/${pid}/exe" executable)
        file(REAL_PATH "${FIXTURE_DIRECTORY}" root)
        if(executable MATCHES "^${root}/instance-[0-9]+/")
            set(alive TRUE)
        endif()
    endif()
    set(${out} ${alive} PARENT_SCOPE)
endfunction()

function(fixture_start index out)
    fixture_instance_directory(${index} directory)
    fixture_write_configuration(${index})
    # Link the build output into the instance directory beside the .env.
    get_filename_component(engine_name "${ENGINE}" NAME)
    set(executable "${directory}/${engine_name}")
    file(REMOVE "${executable}" "${directory}/engine.out" "${directory}/engine.err")
    file(CREATE_LINK "${ENGINE}" "${executable}" COPY_ON_ERROR)
    if(CMAKE_HOST_WIN32)
        execute_process(
            COMMAND powershell -NoProfile -NonInteractive -Command
                "(Start-Process -FilePath '${executable}' -WorkingDirectory '${directory}' -WindowStyle Hidden -PassThru -RedirectStandardOutput '${directory}/engine.out' -RedirectStandardError '${directory}/engine.err').Id"
            OUTPUT_VARIABLE pid
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE result)
    else()
        execute_process(
            COMMAND sh -c "\"$0\" >\"$1\" 2>\"$2\" </dev/null & echo $!"
                "${executable}" "${directory}/engine.out" "${directory}/engine.err"
            WORKING_DIRECTORY "${directory}"
            OUTPUT_VARIABLE pid
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE result)
    endif()
    if(NOT result EQUAL 0 OR NOT pid MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Could not start ${executable} for ${FIXTURE}: ${pid}")
    endif()
    set(${out} ${pid} PARENT_SCOPE)
endfunction()

function(fixture_log_tail index)
    fixture_instance_directory(${index} directory)
    foreach(stream engine.out engine.err)
        if(EXISTS "${directory}/${stream}")
            file(READ "${directory}/${stream}" text)
            string(LENGTH "${text}" length)
            if(length GREATER 4000)
                math(EXPR offset "${length} - 4000")
                string(SUBSTRING "${text}" ${offset} -1 text)
            endif()
            message(STATUS "--- ${directory}/${stream} (tail)\n${text}")
        endif()
    endforeach()
endfunction()

function(fixture_wait_ready index pid)
    math(EXPR port "${API_PORT} + ${index}")
    set(probe "${FIXTURE_DIRECTORY}/ready-${index}.json")
    foreach(attempt RANGE 240)
        fixture_alive(${pid} alive)
        if(NOT alive)
            fixture_log_tail(${index})
            message(FATAL_ERROR "iot-engine instance ${index} of ${FIXTURE} exited before readiness")
        endif()
        file(DOWNLOAD "http://127.0.0.1:${port}/internal/health/ready" "${probe}"
            STATUS status TIMEOUT 2)
        list(GET status 0 code)
        if(code EQUAL 0)
            file(REMOVE "${probe}")
            return()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.25)
    endforeach()
    fixture_log_tail(${index})
    message(FATAL_ERROR "iot-engine instance ${index} of ${FIXTURE} did not become ready")
endfunction()

# A start that must fail, e.g. a rejected migration. The process must exit
# without becoming ready and its output must match `pattern`.
function(fixture_expect_start_failure index pattern)
    fixture_start(${index} pid)
    fixture_instance_directory(${index} directory)
    foreach(attempt RANGE 240)
        fixture_alive(${pid} alive)
        if(NOT alive)
            file(READ "${directory}/engine.out" out)
            file(READ "${directory}/engine.err" err)
            if(NOT "${out}${err}" MATCHES "${pattern}")
                fixture_log_tail(${index})
                message(FATAL_ERROR "iot-engine of ${FIXTURE} failed without matching '${pattern}'")
            endif()
            return()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.25)
    endforeach()
    fixture_stop_process(${pid})
    message(FATAL_ERROR "iot-engine of ${FIXTURE} kept running; expected failure '${pattern}'")
endfunction()

function(fixture_stop_process pid)
    fixture_alive(${pid} alive)
    if(NOT alive)
        return()
    endif()
    if(CMAKE_HOST_WIN32)
        execute_process(COMMAND taskkill /PID ${pid} /F OUTPUT_QUIET ERROR_QUIET)
    else()
        execute_process(COMMAND kill -TERM ${pid} OUTPUT_QUIET ERROR_QUIET)
    endif()
    foreach(attempt RANGE 60)
        fixture_alive(${pid} alive)
        if(NOT alive)
            return()
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.25)
    endforeach()
    execute_process(COMMAND kill -KILL ${pid} OUTPUT_QUIET ERROR_QUIET)
endfunction()

function(fixture_start_all)
    if(SEED_UPLOADS)
        # Startup recovery input: an abandoned upload, a registered image and an
        # unrelated file in the first instance's firmware directory.
        fixture_instance_directory(0 directory)
        file(WRITE "${directory}/firmware/00000000-0000-4000-8000-000000000004.upload" "abandoned\n")
        file(WRITE "${directory}/firmware/00000000-0000-4000-8000-000000000005.bin" "preserved\n")
        file(WRITE "${directory}/firmware/unrelated.upload" "unrelated\n")
    endif()
    set(pids "")
    math(EXPR last "${INSTANCES} - 1")
    foreach(index RANGE ${last})
        fixture_start(${index} pid)
        list(APPEND pids ${pid})
        file(WRITE "${fixture_state}" "set(fixture_pids \"${pids}\")\n")
    endforeach()
    foreach(index RANGE ${last})
        list(GET pids ${index} pid)
        fixture_wait_ready(${index} ${pid})
    endforeach()
    set(fixture_pids "${pids}" PARENT_SCOPE)
endfunction()

function(fixture_stop_all)
    if(EXISTS "${fixture_state}")
        include("${fixture_state}")
        foreach(pid IN LISTS fixture_pids)
            fixture_stop_process(${pid})
        endforeach()
        file(REMOVE "${fixture_state}")
    endif()
endfunction()

function(fixture_test_environment)
    set(ENV{ARCHITECTURE_DATABASE_URL} "${fixture_database_url}")
    set(ENV{ARCHITECTURE_REDIS_URL} "${fixture_redis_url}")
    set(ENV{TEST_BASE_URL} "http://127.0.0.1:${API_PORT}")
    set(ENV{TEST_EDGE_PLATFORM_ID} "${fixture_platform_id}")
    set(ENV{RPC_TEST_WORKERS} 2)
    fixture_instance_directory(0 directory)
    set(ENV{IOT_TEST_FIXTURE_DIRECTORY} "${directory}")
    set(ENV{IOT_TEST_ENGINE} "${ENGINE}")
    if(GB28181)
        set(ENV{GB_TEST_SIP_PORT} ${sip_port})
    endif()
    set(ports "")
    math(EXPR last "${INSTANCES} - 1")
    foreach(index RANGE ${last})
        math(EXPR port "${API_PORT} + ${index}")
        list(APPEND ports ${port})
    endforeach()
    list(JOIN ports "," ports)
    set(ENV{LIVE_QUERY_API_PORTS} "${ports}")
endfunction()

function(fixture_run_script)
    fixture_bun(run "${SOURCE_DIR}/${SCRIPT}" ${ARGN})
endfunction()

# Phase protocol of tests/*-migration-integration.ts: fresh schema, restart,
# upgrade from the previous schema, checksum drift rejection, failed upgrade
# rollback, recovery and repeated startup.
function(fixture_run_migration)
    set(ENV{ARCHITECTURE_MIGRATION_STATE} "${FIXTURE_DIRECTORY}/migration-state.json")
    fixture_run_script(initial)
    fixture_stop_all()
    fixture_start_all()
    fixture_run_script(restart)
    fixture_stop_all()
    fixture_run_script(prepare-upgrade)
    fixture_start_all()
    fixture_run_script(upgraded)
    fixture_stop_all()
    fixture_run_script(prepare-drift)
    fixture_expect_start_failure(0 "checksum|migration")
    fixture_run_script(check-drift)
    fixture_run_script(prepare-failure)
    fixture_expect_start_failure(0 "${MIGRATION_FAILURE}")
    fixture_run_script(check-failure)
    fixture_start_all()
    fixture_run_script(upgraded)
    fixture_stop_all()
    fixture_start_all()
    fixture_run_script(repeated)
endfunction()

# --- Actions ----------------------------------------------------------------

math(EXPR sip_port "${API_PORT} + 9")
if(NOT INSTANCES)
    set(INSTANCES 1)
endif()

if(ACTION STREQUAL "start")
    fixture_stop_all()
    file(REMOVE_RECURSE "${FIXTURE_DIRECTORY}")
    file(MAKE_DIRECTORY "${FIXTURE_DIRECTORY}")
    fixture_services(reset)
    fixture_start_all()
elseif(ACTION STREQUAL "stop")
    fixture_stop_all()
    fixture_services(drop)
elseif(ACTION STREQUAL "run")
    set(script_arguments "")
    if(DEFINED EXECUTABLE)
        if(NOT EXISTS "${EXECUTABLE}")
            fixture_skip("${EXECUTABLE} is not built")
        endif()
        set(script_arguments "${EXECUTABLE}")
    endif()
    if(MQTT)
        if(NOT "$ENV{IOT_TEST_MQTT_URL}" MATCHES "^mqtt://([^:/@]+):([0-9]+)/?$")
            fixture_skip("IOT_TEST_MQTT_URL (mqtt://host:port of an anonymous MQTT broker) is not set")
        endif()
        set(ENV{OPEN_MQTT_BROKER_URL} "mqtt://${CMAKE_MATCH_1}:${CMAKE_MATCH_2}")
        set(ENV{OPEN_MQTT_BROKER_PORT} "${CMAKE_MATCH_2}")
    endif()
    fixture_test_environment()
    if(MANAGED)
        # The test owns the process lifecycle: start from an empty database.
        fixture_stop_all()
        file(REMOVE_RECURSE "${FIXTURE_DIRECTORY}")
        file(MAKE_DIRECTORY "${FIXTURE_DIRECTORY}/instance-0")
        fixture_services(reset)
        if(DEFINED MIGRATION_FAILURE)
            fixture_start_all()
            fixture_run_migration()
            fixture_stop_all()
        else()
            fixture_run_script(${script_arguments})
        endif()
        fixture_services(drop)
    else()
        if(NOT EXISTS "${fixture_state}")
            message(FATAL_ERROR "Fixture ${FIXTURE} is not running; run its setup test integration-${FIXTURE}-start")
        endif()
        fixture_run_script(${script_arguments})
    endif()
else()
    message(FATAL_ERROR "Unknown ACTION '${ACTION}'")
endif()
