if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()

# Clang cannot deduce wait() before its definition in this coroutine template.
# Await the same worker signal directly; no API or shutdown semantics change.
set(source_file "${SOURCE_DIR}/ruvia-web/src/client/client_close_state.h")
file(READ "${source_file}" content)
string(REPLACE "\r\n" "\n" content "${content}")
string(SHA256 source_hash "${content}")
if(source_hash STREQUAL "5a748a7580c73e0e0428992df750886a9612d7c6a30d8e6008403c525570cbab")
    set(original "        while (!complete_) {\n            co_await wait();\n        }")
    set(patched "        while (!complete_) {\n            co_await signal_.wait();\n        }")
    string(REPLACE "${original}" "${patched}" content "${content}")
    string(SHA256 patched_hash "${content}")
    if(NOT patched_hash STREQUAL "a23e7ad2cbb05780d4cb4426086a27d27cf98748a4efc9276312d0aad75f499e")
        message(FATAL_ERROR "Ruvia client_close_state patch did not match")
    endif()
    file(WRITE "${source_file}" "${content}")
elseif(NOT source_hash STREQUAL "a23e7ad2cbb05780d4cb4426086a27d27cf98748a4efc9276312d0aad75f499e")
    message(FATAL_ERROR "Unexpected pinned Ruvia client_close_state source: ${source_hash}")
endif()

# MSVC 19.51 cannot preserve the required symmetric-transfer tail call when
# the synchronous socket write is inlined into the HTTP session resume body.
# Keep this ordinary function call out of that body; retain the same fast path.
set(source_file "${SOURCE_DIR}/ruvia-web/src/server/http1_response_output.h")
file(READ "${source_file}" content)
string(REPLACE "\r\n" "\n" content "${content}")
string(SHA256 source_hash "${content}")
if(source_hash STREQUAL "8f3162fff08c16440c8cc5ec2d320ac8f36e771d8aa530e0707370b92cb24819")
    set(original "    [[nodiscard]] bool start(std::string_view body = {}) noexcept {")
    set(patched "    // MSVC's resumed session must tail-transfer at task suspension. Keep\n    // the synchronous socket-write expansion out of that resume function.\n    [[nodiscard]]\n#if defined(_MSC_VER) && !defined(__clang__)\n    __declspec(noinline)\n#endif\n    bool start(std::string_view body = {}) noexcept {")
    string(REPLACE "${original}" "${patched}" content "${content}")
    string(SHA256 patched_hash "${content}")
    if(NOT patched_hash STREQUAL "6a2287c39ae2c1cf5f94a987af6504accc85028a46f21444b83d02faf0998255")
        message(FATAL_ERROR "Ruvia http1_response_output patch did not match")
    endif()
    file(WRITE "${source_file}" "${content}")
elseif(NOT source_hash STREQUAL "6a2287c39ae2c1cf5f94a987af6504accc85028a46f21444b83d02faf0998255")
    message(FATAL_ERROR "Unexpected pinned Ruvia http1_response_output source: ${source_hash}")
endif()
